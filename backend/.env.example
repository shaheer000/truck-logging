# Copy to .env and fill in. All values have safe defaults for local dev.
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave USE_POSTGRES=False to use SQLite (zero setup).
USE_POSTGRES=False
POSTGRES_DB=trucklog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OpenRouteService API key. If blank, the app falls back to haversine routing.
ORS_API_KEY=

# CORS — the Vite dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
