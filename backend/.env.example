# Copy this file to backend/.env and fill in real values before `docker compose up`.
# All values have safe defaults for local dev; tighten everything before EC2.

# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
# Comma-separated. Include your EC2 public DNS and any custom domain.
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com,ec2-1-2-3-4.compute-1.amazonaws.com

# --- Database (matches docker-compose service names) ---
# In docker-compose, set POSTGRES_HOST=db (the service name).
# For local dev outside docker, set USE_POSTGRES=False to use SQLite.
USE_POSTGRES=True
POSTGRES_DB=trucklog
POSTGRES_USER=trucklog
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS / CSRF (your Vercel frontend domain) ---
# After your first Vercel deploy, replace these with the real prod URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trucklog-pro.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://trucklog-pro.vercel.app,https://api.example.com
# Set to true while iterating with Vercel preview deployments (*.vercel.app).
CORS_ALLOW_VERCEL_PREVIEWS=True

# --- HTTPS hardening (turn on once your nginx is serving TLS) ---
SECURE=False

# --- External services ---
# Get a free key at https://openrouteservice.org/dev/#/signup. Empty value
# falls back to a haversine route estimate.
ORS_API_KEY=
